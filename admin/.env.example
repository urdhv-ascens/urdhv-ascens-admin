# Backend API Endpoint (Hostinger PHP API Gateway or Local Mock)
# Local: http://localhost:8080/api
# Production: https://gold-cat-133405.hostingersite.com/api
NEXT_PUBLIC_API_URL=https://gold-cat-133405.hostingersite.com/api

# Admin Gateway Secret Key (Must match URDHV_ADMIN_KEY on server)
URDHV_ADMIN_KEY=urdhv_admin_2026_secure

# Firebase Cloud Firestore / Storage (Optional Sync)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=urdhv-ascens.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=urdhv-ascens
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=urdhv-ascens.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
