rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true || 
         request.auth.token.email.matches('.*@urdhvascens\\.com$'));
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Site Content (Read by public, written only by Admin)
    match /content/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Curated Projects (Read by public, written only by Admin)
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Capabilities & Services (Read by public, written only by Admin)
    match /capabilities/{capabilityId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Booklets Catalog & Metadata (Read by public, written only by Admin)
    match /booklets/{bookletId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Ads Configuration (Read by public, written only by Admin)
    match /ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Registered Readers & Student Progress (User Isolation & Anti-IDOR)
    match /readers/{readerId} {
      // Reader can only read their own profile
      allow read: if isOwner(readerId) || isAdmin();
      // Public can create a registration entry with sanitized fields
      allow create: if request.resource.data.keys().hasAll(['name', 'email']) &&
                       request.resource.data.name is string &&
                       request.resource.data.email is string &&
                       request.resource.data.name.size() > 0 &&
                       request.resource.data.name.size() < 100 &&
                       request.resource.data.email.size() < 150;
      // Only owner or admin can update their own reader record
      allow update, delete: if isOwner(readerId) || isAdmin();
    }

    // 7. Media & Asset Registry
    match /media/{assetId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Admin Audit & Security Logs (Admin only, never readable by public)
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
