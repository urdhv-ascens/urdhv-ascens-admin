# ==============================================================================
# Ūrdhv Ascens — Internal Data Directory Protection
# Prevents direct HTTP access to JSON storage and session files
# ==============================================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

Options -Indexes -FollowSymLinks
